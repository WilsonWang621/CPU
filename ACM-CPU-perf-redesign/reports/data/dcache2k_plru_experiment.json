  "patch": "--- a/rtl/cache.sv\n+++ b/rtl/cache.sv\n@@ -67,7 +67,42 @@\n             assign dirty_word[row*WORDS+word]=dirty_bytes[row/WAYS][row%WAYS][4*word+:4];\n         end\n     end\n-    logic [YB-1:0] replace_way [SETS];\n+    localparam integer REPLACEMENT_BITS=WAYS==4 ? 3:1;\n+    logic [REPLACEMENT_BITS-1:0] replace_state [SETS];\n+    // Bits point toward the less-recently used subtree/way. Touching one\n+    // leaf points both nodes on its path toward the opposite child.\n+    function automatic logic [2:0] replacement_touch(input logic [2:0] state,\n+                                                     input logic [1:0] way);\n+        logic [2:0] next_state;\n+        begin\n+            next_state=state;\n+            if(WAYS==4) begin\n+                next_state[0]=~way[1];\n+                if(way[1]) next_state[2]=~way[0];\n+                else next_state[1]=~way[0];\n+            end else begin\n+                next_state='0;\n+                if(WAYS==2) next_state[0]=~way[0];\n+            end\n+            return next_state;\n+        end\n+    endfunction\n+    // Visit the preferred subtree before the other subtree, and each\n+    // preferred leaf before its sibling. Locked leaves are skipped below.\n+    function automatic integer replacement_rank(input logic [2:0] state,\n+                                                 input integer rank);\n+        integer half,leaf;\n+        begin\n+            half=0;leaf=0;\n+            if(WAYS==4) begin\n+                half=int'(state[0])^(rank>>1);\n+                leaf=(half==0 ? int'(state[1]):int'(state[2]))^(rank&1);\n+                return 2*half+leaf;\n+            end\n+            if(WAYS==2) return int'(state[0])^rank;\n+            return 0;\n+        end\n+    endfunction\n     logic locked [SETS][WAYS];\n \n     typedef enum logic [1:0] {M_FREE,M_WB,M_READ,M_ERROR} phase_t;\n@@ -276,7 +311,7 @@\n             if(!locked[req_set][y] && !tag_valid[req_set][y] && victim_way<0) victim_way=y;\n         end\n         for(integer n=0;n<WAYS;n=n+1) begin\n-            idx=(int'(replace_way[req_set])+n)%WAYS;\n+            idx=replacement_rank(3'(replace_state[req_set]),n);\n             if(!locked[req_set][idx] && victim_way<0) victim_way=idx;\n         end\n         if(hit_way>=0) begin\n@@ -611,20 +646,20 @@\n     end\n     end endgenerate\n     for(genvar s=0;s<SETS;s=s+1) begin:g_set\n-        // Select once in source order: the highest matching MSHR wins,\n-        // followed by a same-cycle CPU hit. Each set has one state write.\n-        logic [YB-1:0] replace_next;\n+        // Train in source order. Higher MSHRs overwrite shared tree-path\n+        // bits later; a same-cycle hit trains last. One state write per set.\n+        logic [REPLACEMENT_BITS-1:0] replace_next;\n         always_comb begin\n-            replace_next=replace_way[s];\n+            replace_next=replace_state[s];\n             for(integer m=0;m<MSHRS;m=m+1)\n                 if(install_line[m] && m_d[m].set_index==SB'(s))\n-                    replace_next=YB'((int'(m_d[m].way)+1)%WAYS);\n+                    replace_next=REPLACEMENT_BITS'(replacement_touch(3'(replace_next),2'(m_d[m].way)));\n             if(cpu_req_valid && cpu_req_ready && hit && !req_bad && req_set==SB'(s))\n-                replace_next=YB'((hit_way+1)%WAYS);\n+                replace_next=REPLACEMENT_BITS'(replacement_touch(3'(replace_next),2'(hit_way)));\n         end\n         always_ff @(posedge clk) begin\n-            if(rst) replace_way[s]<='0;\n-            else replace_way[s]<=replace_next;\n+            if(rst) replace_state[s]<='0;\n+            else replace_state[s]<=replace_next;\n         end\n         for(genvar y=0;y<WAYS;y=y+1) begin:g_way\n             wire fill_here=response_fire && !mem_rsp_error && !returning.flush && !returning.write &&\n",
