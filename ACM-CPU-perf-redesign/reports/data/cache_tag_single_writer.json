{
  "scope": "One private RTL structural rewrite of portable cache4c5: only replace_way per-set and tag_valid/line_addr per-line state writers. Highest matching MSHR retains priority and CPU hit remains final replacement-pointer writer; reset still dominates. No pipeline stage or state added. No production/cache-agent files changed.",
  "sources": {
    "baseline_sha256": "4c5c008547bc50b9718f4177ea8eefe5fe1aadf38e923653ed99b17fbb8f6cb6",
    "candidate_sha256": "7b3b51f4e125abbe6ed3bad7d9dea6c1ed9a25e5d19cb91dcbb044a24ca4c3af",
    "scope": "Single combinational final selection + one NBA per set/line; only replace_way, tag_valid, line_addr writers changed."
  },
  "patch_path": "build/cache-tag-write-port/tag-write-port.patch",
  "patch_sha256": "0682be18a9c52901f949f44d148de04aa3bce2a8b12007cc9a8666c313ad02c6",
  "patch": "--- a/rtl/cache.sv\n+++ b/rtl/cache.sv\n@@ -611,15 +611,20 @@\n     end\n     end endgenerate\n     for(genvar s=0;s<SETS;s=s+1) begin:g_set\n+        // Select once in source order: the highest matching MSHR wins,\n+        // followed by a same-cycle CPU hit. Each set has one state write.\n+        logic [YB-1:0] replace_next;\n+        always_comb begin\n+            replace_next=replace_way[s];\n+            for(integer m=0;m<MSHRS;m=m+1)\n+                if(install_line[m] && m_d[m].set_index==SB'(s))\n+                    replace_next=YB'((int'(m_d[m].way)+1)%WAYS);\n+            if(cpu_req_valid && cpu_req_ready && hit && !req_bad && req_set==SB'(s))\n+                replace_next=YB'((hit_way+1)%WAYS);\n+        end\n         always_ff @(posedge clk) begin\n             if(rst) replace_way[s]<='0;\n-            else begin\n-                for(integer m=0;m<MSHRS;m=m+1)\n-                    if(install_line[m] && m_d[m].set_index==SB'(s))\n-                        replace_way[s]<=YB'((int'(m_d[m].way)+1)%WAYS);\n-                if(cpu_req_valid && cpu_req_ready && hit && !req_bad && req_set==SB'(s))\n-                    replace_way[s]<=YB'((hit_way+1)%WAYS);\n-            end\n+            else replace_way[s]<=replace_next;\n         end\n         for(genvar y=0;y<WAYS;y=y+1) begin:g_way\n             wire fill_here=response_fire && !mem_rsp_error && !returning.flush && !returning.write &&\n@@ -632,12 +637,18 @@\n             for(genvar m=0;m<MSHRS;m=m+1) begin:g_install\n                 assign installing[m]=install_line[m] && m_d[m].set_index==SB'(s) && m_d[m].way==YB'(y);\n             end\n+            logic tag_valid_next;\n+            logic [31:0] line_addr_next;\n+            always_comb begin\n+                tag_valid_next=tag_valid[s][y];line_addr_next=line_addr[s][y];\n+                for(integer m=0;m<MSHRS;m=m+1)\n+                    if(installing[m]) begin\n+                        tag_valid_next=1;line_addr_next=m_d[m].line;\n+                    end\n+            end\n             always_ff @(posedge clk) begin\n                 if(rst) begin tag_valid[s][y]<=0;line_addr[s][y]<='0;end\n-                else for(integer m=0;m<MSHRS;m=m+1)\n-                    if(installing[m]) begin\n-                        tag_valid[s][y]<=1;line_addr[s][y]<=m_d[m].line;\n-                    end\n+                else begin tag_valid[s][y]<=tag_valid_next;line_addr[s][y]<=line_addr_next;end\n             end\n             logic [LINE_BYTES-1:0] valid_next,dirty_next;\n             always_comb begin\n",
