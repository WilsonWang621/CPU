+static void waiter_collision(Bench& b) {
+    b.reset();b.random_wait=false;b.fail_read=0;
+    b.access(5*LINE_BYTES);
+    b.accept_cpu=false;
+    b.send(5*LINE_BYTES,false,0,0,100);
+    b.send(5*LINE_BYTES,false,0,0,101);
+    b.send(0,false,0,0,102,true);
+    b.send(0,false,0,0,103,true);
+    while(!b.read_error_due()) b.tick();
+    b.accept_cpu=true;b.offer(0,false,0,0,104,true);
+    require(b.tick(),"same-cycle failed-read allocation was not accepted");
+    b.dut.cpu_req_valid=0;b.drain();
+    require(b.responses==6,"collision lost or duplicated waiter");
+    b.fail_read=-1;auto reads=b.reads;b.access(0);
+    require(b.reads==reads+1,"collision failed sector did not retry alone");
+    b.flush();
+    if(!READ_ONLY) {
+        b.reset();b.random_wait=false;b.fail_read=0;
+        b.send(0,false,0,0,110,true);b.send(0,false,0,0,111,true);
+        while(!b.read_error_due()) b.tick();
+        b.offer(0,true,0x12345678,0xf,112);
+        require(b.tick(),"same-cycle committed-store allocation was not accepted");
+        b.dut.cpu_req_valid=0;b.drain();b.fail_read=-1;
+        reads=b.reads;b.access(0);require(b.reads==reads,"error overwrote newly committed valid word");b.flush();
+    }
+}
+
 int main(int argc,char** argv) {
     Verilated::commandArgs(argc,argv);
     const char* stage="reset";
     try {
+        if(argc==2 && std::string(argv[1])=="--collision-trace") {
+            Bench b;waiter_collision(b);
+            std::cout<<"collision trace: cycles="<<b.trace_cycles<<" hash="<<b.trace_hash<<'\n';return 0;
+        }
         if(argc==3 && std::string(argv[1])=="--window-trace") {
             Bench b;bounded_window_trace(b,unsigned(std::stoul(argv[2])));return 0;
         }
