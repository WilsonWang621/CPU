+  // The scheduler admits at most two memory operations each cycle and every
+  // live Load releases its EX slot on this cycle's AGU/retry path. Compress the
+  // eligible Loads into two physical AGUs in original EX-lane order.
+  always_comb begin : load_port_compaction
+    integer selected;
+    selected=0;load_live_mask=0;load_eligible_mask=0;load_port_valid=0;
+    for(integer lane=0;lane<4;lane=lane+1) begin
+      load_live_mask[lane]=ex_q[lane].valid && ex_q[lane].op==OP_LOAD &&
+        live(ex_q[lane].rid,ex_q[lane].generation);
+      load_eligible_mask[lane]=state_q==RUN && load_live_mask[lane] &&
+        !killed(ex_q[lane].rid,head_q,redirect,recovery_age+(RW+1)'(recovery_keep));
+    end
+    for(integer port=0;port<2;port=port+1) load_agu[port]='0;
+    for(integer lane=0;lane<4;lane=lane+1) begin
+      if(load_eligible_mask[lane]) begin
+        for(integer port=0;port<2;port=port+1) if(selected==port) begin
+          load_port_valid[port]=1;
+          load_agu[port].rid=ex_q[lane].rid;
+          load_agu[port].a=ex_q[lane].a;load_agu[port].imm=ex_q[lane].imm;
+          load_agu[port].source_lane=2'(lane);
+        end
+        selected=selected+1;
+      end
+    end
+  end
