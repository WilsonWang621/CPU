--- /dev/null
+++ b/verilog/area_v2/v2_timing_buffer.sv
@@ -0,0 +1,19 @@
+// Combinational identity built from two real inverter banks. Preserved
+// boundaries prevent a wide tag distribution net from absorbing both stages.
+// Both stages remain ordinary RTL and are mapped and timed by the default flow.
+(* keep_hierarchy=1 *)
+module v2_timing_buffer #(parameter integer WIDTH=1)(
+  input wire [WIDTH-1:0] data_in,
+  output wire [WIDTH-1:0] data_out
+);
+  wire [WIDTH-1:0] inverted;
+  (* keep=1 *) v2_inverter_bank #(.WIDTH(WIDTH)) first (.data_in(data_in),.data_out(inverted));
+  (* keep=1 *) v2_inverter_bank #(.WIDTH(WIDTH)) second (.data_in(inverted),.data_out(data_out));
+endmodule
+(* keep_hierarchy=1 *)
+module v2_inverter_bank #(parameter integer WIDTH=1)(
+  input wire [WIDTH-1:0] data_in,
+  output wire [WIDTH-1:0] data_out
+);
+  assign data_out=~data_in;
+endmodule
