+// Library-backed combinational fanout buffer. The native course synthesis
+// reads the real ASAP7 cell; simulation uses its non-inverting logic function.
+module v2_timing_buffer #(parameter integer WIDTH=1)(
+  input wire [WIDTH-1:0] data_in,
+  output wire [WIDTH-1:0] data_out
+);
+  for(genvar bit_id=0;bit_id<WIDTH;bit_id=bit_id+1) begin: bit_buffer
+`ifdef SYNTHESIS
+    (* keep=1 *) BUFx12_ASAP7_75t_R drive (.A(data_in[bit_id]),.Y(data_out[bit_id]));
+`else
+    assign data_out[bit_id]=data_in[bit_id];
+`endif
+  end
+endmodule
