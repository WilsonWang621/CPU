+// Each table keeps its own retirement cursor; no global next-head adder.
+(* keep_hierarchy=1 *)
+module v2_commit_slots #(parameter integer SLOT_BITS=5)(
+  input wire clk,rst,
+  input wire [1:0] advance,
+  output logic [2*SLOT_BITS-1:0] slot
+);
+  for(genvar lane=0;lane<2;lane=lane+1) begin: cursor
+    always_ff @(posedge clk) begin
+      if(rst) slot[lane*SLOT_BITS+:SLOT_BITS]<=SLOT_BITS'(lane);
+      else slot[lane*SLOT_BITS+:SLOT_BITS]<=slot[lane*SLOT_BITS+:SLOT_BITS]+SLOT_BITS'(advance);
+    end
+  end
+endmodule
